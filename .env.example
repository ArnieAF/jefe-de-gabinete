# Copia este archivo a ".env" y completa lo que falte. ".env" NO se sube al repo.
# Los comentarios van en su propia línea (no al final de un valor) para que
# docker compose y python-dotenv los lean igual.

# --- Base de datos (docker compose) ---
POSTGRES_USER=gabinete
POSTGRES_DB=gabinete
# Puerto local; 5433 evita chocar con un PostgreSQL ya instalado en el 5432.
POSTGRES_PORT=5433
# OBLIGATORIA: elige una contraseña local. Si la dejas vacía, docker compose se niega a arrancar.
POSTGRES_PASSWORD=

# --- Proveedor del modelo (la interfaz se confirma en F1) ---
# Valores previstos: ollama | gemini | anthropic
GABINETE_LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# Opcional. El nivel gratuito de Gemini usa lo que envías para mejorar productos de Google:
# solo úsalo con los datos falsos de fixtures/, nunca con tus notas reales.
GEMINI_API_KEY=
# Opcional. Solo si algún día hay saldo en la API de Anthropic.
ANTHROPIC_API_KEY=

# --- Datos ---
# Carpeta de notas Markdown. Por defecto, las notas FALSAS de prueba.
GABINETE_NOTES_DIR=./fixtures/vault
