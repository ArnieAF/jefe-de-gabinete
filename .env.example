# Copia este archivo a ".env" y completa lo que falte. ".env" NO se sube al repo.
# Los comentarios van en su propia línea (no al final de un valor) para que
# docker compose y python-dotenv los lean igual.

# --- Base de datos (docker compose) ---
POSTGRES_USER=gabinete
POSTGRES_DB=gabinete
# Puerto local; 5433 evita chocar con un PostgreSQL ya instalado en el 5432.
POSTGRES_PORT=5433
# OBLIGATORIA: elige una contraseña local, sin caracteres $ ni comillas (compose interpola el $).
# Si la dejas vacía, docker compose se niega a arrancar.
POSTGRES_PASSWORD=

# --- Proveedor del modelo ---
# Nota: estas variables las leerán los adaptadores (T5, T10) y las CLI de F2 a F5; hoy ningún código las usa.
# Regla D10: todo proveedor distinto de "ollama" es una nube. Úsalo ÚNICAMENTE con
# GABINETE_NOTES_DIR=./fixtures/vault (datos falsos); tus notas reales solo con ollama local.
# Valores previstos: ollama | gemini | anthropic
GABINETE_LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# Opcional. El nivel gratuito de Gemini usa lo que envías para mejorar productos de Google:
# solo úsalo con los datos falsos de fixtures/, nunca con tus notas reales.
GEMINI_API_KEY=
# Opcional. Solo si algún día hay saldo en la API de Anthropic. Sigue siendo una nube: aplica la regla D10.
ANTHROPIC_API_KEY=

# --- Datos (tampoco las lee aún ningún código) ---
# Carpeta de notas Markdown. Por defecto, las notas FALSAS de prueba.
GABINETE_NOTES_DIR=./fixtures/vault
