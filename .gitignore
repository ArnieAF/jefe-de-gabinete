# Secretos: nunca al repo (la plantilla .env.example sí se versiona)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Datos y salidas locales
data/
*.sqlite
*.db
evals-out/

# Editor / sistema operativo
.idea/
.vscode/
.DS_Store
Thumbs.db

# Más secretos y credenciales (llaves, cuentas de servicio, direnv)
.envrc
*.env
*.pem
*.key
*.p12
*.pfx
*.ppk
id_rsa*
credentials*.json
service-account*.json
secrets/

# Registros del harness (F1): pueden contener texto de notas, no se versionan
runs/
logs/
traces/
*.jsonl
!tests/**/*.jsonl

# Datos reales: nunca dentro del repo (este patrón es solo una red de seguridad)
vault-real/
notas-reales/
data-real/
